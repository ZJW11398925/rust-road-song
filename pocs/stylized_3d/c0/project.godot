; C0 private draft. Godot 4.7.1.
config_version=5
[application]
config/name="C0 Spatial Spike"
run/main_scene="res://garage.tscn"
[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.075,0.085,0.10,1)
[internationalization]
locale/fallback="zh_CN"
locale/test="zh_CN"
